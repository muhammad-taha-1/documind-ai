# Copy this file to .env and fill in the values. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL with the pgvector extension. Matches docker-compose.yml.
DATABASE_URL="postgresql://documind:documind@localhost:5432/documind?schema=public"

# ── Authentication (NextAuth, GitHub sign-in) ────────────────────────────────
# The URL the app is served from
NEXTAUTH_URL="http://localhost:3000"
# Signs session tokens. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
# Create an OAuth app at https://github.com/settings/developers with the
# callback URL http://localhost:3000/api/auth/callback/github
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"

# ── AI ───────────────────────────────────────────────────────────────────────
# Anthropic: Claude answers questions and names chats. https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
# OpenAI: used only for embeddings (text-embedding-3-small). https://platform.openai.com
OPENAI_API_KEY="sk-..."

# ── Storage (optional) ───────────────────────────────────────────────────────
# Where uploaded PDFs and chat images are kept. Defaults to ./uploads
# UPLOAD_DIR="/var/lib/documind/uploads"
