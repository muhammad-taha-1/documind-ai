generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  /// GitHub returns this when the OAuth app has expiring user tokens enabled;
  /// NextAuth saves every token field, so the column must exist
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id             String          @id @default(cuid())
  title          String
  fileName       String
  fileSize       Int
  mimeType       String          @default("application/pdf")
  filePath       String
  pageCount      Int?
  status         DocumentStatus  @default(UPLOADING)
  /// Why processing failed, shown to the user (e.g. "image-only PDF")
  errorMessage   String?
  /// Progress counters for the embedding step ("Embedding 15/45 chunks...")
  totalChunks    Int             @default(0)
  embeddedChunks Int             @default(0)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  EMBEDDING
  READY
  ERROR
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  content    String                       @db.Text
  pageNumber Int?
  chunkIndex Int
  tokenCount Int?
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// 1536 dimensions = OpenAI text-embedding-3-small. Prisma can't read or write
  /// vector columns through its query API, but declaring the column as Unsupported
  /// keeps it in the schema so `migrate dev` doesn't treat it as drift.
  /// Read/write it with $queryRaw / $executeRaw. Deliberately unindexed: exact
  /// search is fast at this scale and, unlike HNSW, stays correct when results
  /// are filtered by user/document (see spec, Phase 2).
  embedding  Unsupported("vector(1536)")?
  /// Replies that used this chunk as a source
  usedBy     MessageSource[]
  createdAt  DateTime                     @default(now())

  @@index([documentId])
}

model Conversation {
  id          String    @id @default(cuid())
  title       String    @default("New Chat")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  documentIds String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  role           MessageRole
  content        String       @db.Text
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  model          String?
  tokensUsed     Int?
  /// How the documents were searched for this reply (assistant messages from Phase 10 on)
  retrieval      RetrievalMode?
  /// The passages Claude was given, as numbered in the prompt ("[Source N]")
  sources        MessageSource[]
  /// Tools Claude used for this reply, each with its result: ToolCall[] in src/types.
  /// One list rather than separate call/result columns, so they can't get out of step.
  toolCalls      Json?
  /// Vision attachments (Phase 14), e.g. [{ type: "image", path, mediaType }]
  attachments    Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageRole {
  user
  assistant
  system
}

enum RetrievalMode {
  /// The documents were small enough to send in full — no search needed
  FULL_TEXT
  /// Vector search found passages that match the question well
  MATCHED
  /// The closest passages only loosely match the question
  WEAK_MATCH
  /// Nothing in the documents was close enough to send
  NO_MATCH
  /// The chat's documents have no searchable text (deleted, or being reprocessed)
  NO_DOCUMENTS
}

/// One passage given to Claude for a reply. A table rather than an ID array on
/// Message so each source keeps its score and its number, and disappears with
/// its chunk (document deleted or reprocessed) instead of dangling.
model MessageSource {
  id         String        @id @default(cuid())
  messageId  String
  message    Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// The N in "[Source N]": 1-based, in the order Claude saw the passages
  position   Int
  chunkId    String
  chunk      DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  /// Cosine similarity to the question; null when the full text was sent (no search ran)
  similarity Float?

  @@unique([messageId, position])
  @@index([chunkId])
}
